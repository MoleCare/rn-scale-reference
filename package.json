{
  "name": "@molecare/scale-reference",
  "version": "1.0.0",
  "description": "Estimate sizes in a photo from an object of known size (a sticker or a coin): pixel-to-millimetre scale, tilt checks and comparability. TypeScript, no native code.",
  "license": "Apache-2.0",
  "author": "MoleCare LTD <info@molecare.co.uk> (https://www.molecare.co.uk)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MoleCare/rn-scale-reference.git"
  },
  "bugs": {
    "url": "https://github.com/MoleCare/rn-scale-reference/issues"
  },
  "homepage": "https://github.com/MoleCare/rn-scale-reference#readme",
  "keywords": [
    "react-native",
    "expo",
    "scale",
    "calibration",
    "measurement",
    "photo",
    "coin",
    "typescript"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./lib/commonjs/index.js",
  "module": "./lib/module/index.js",
  "types": "./lib/typescript/commonjs/src/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./lib/typescript/module/src/index.d.ts",
        "default": "./lib/module/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/src/index.d.ts",
        "default": "./lib/commonjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "!**/__tests__",
    "!**/*.tsbuildinfo",
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "SECURITY.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "bob build",
    "clean": "del-cli lib coverage",
    "prepack": "bob build",
    "typecheck": "tsc -p tsconfig.json && tsc -p examples/tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "jest",
    "check:package": "bob build && publint --strict && attw --pack .",
    "check:consumer": "bash scripts/check-consumer.sh"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@babel/core": "^7.28.0",
    "@babel/preset-env": "^7.28.0",
    "@babel/preset-typescript": "^7.27.0",
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "babel-jest": "^30.5.2",
    "del-cli": "^7.0.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.5.2",
    "prettier": "^3.9.9",
    "publint": "^0.3.24",
    "react-native-builder-bob": "^0.43.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1"
  },
  "jest": {
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/__tests__"
    ],
    "collectCoverageFrom": [
      "<rootDir>/src/**/*.ts",
      "!<rootDir>/src/index.ts"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 100,
        "functions": 100,
        "lines": 100,
        "statements": 100
      }
    },
    "moduleNameMapper": {
      "^@molecare/scale-reference$": "<rootDir>/src/index.ts"
    }
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "commonjs",
        {
          "esm": true
        }
      ],
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "prettier": {
    "singleQuote": true,
    "trailingComma": "es5"
  },
  "publishConfig": {
    "access": "public"
  }
}
